{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus / VictoriaMetrics",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "__requires": [
    { "type": "grafana", "id": "grafana", "name": "Grafana", "version": "10.0.0" },
    { "type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0" },
    { "type": "panel", "id": "stat", "name": "Stat", "version": "" },
    { "type": "panel", "id": "timeseries", "name": "Time series", "version": "" },
    { "type": "panel", "id": "table", "name": "Table", "version": "" }
  ],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "graphTooltip": 0,
  "id": null,
  "panels": [
    {
      "type": "stat",
      "title": "Cycle Success Rate",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "sum(increase(k6_k6_robot_cycles_completed_total{scenario=\"robot\",testid=~\"$testid\",device=~\"$device\"}[$__range])) / sum(increase(k6_k6_robot_cycles_started_total{scenario=\"robot\",testid=~\"$testid\",device=~\"$device\"}[$__range]))",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 0.9 },
              { "color": "green", "value": 0.98 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      }
    },
    {
      "type": "stat",
      "title": "Register Success Rate",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "sum(increase(k6_k6_robot_registers_completed_total{scenario=\"robot\",testid=~\"$testid\",device=~\"$device\"}[$__range])) / clamp_min(sum(increase(k6_k6_robot_registers_started_total{scenario=\"robot\",testid=~\"$testid\",device=~\"$device\"}[$__range])), 1)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 0.9 },
              { "color": "green", "value": 0.98 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      }
    },
    {
      "type": "stat",
      "title": "Cycles Completed",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "sum(increase(k6_k6_robot_cycles_completed_total{scenario=\"robot\",testid=~\"$testid\",device=~\"$device\"}[$__range]))",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      }
    },
    {
      "type": "stat",
      "title": "Build ID Updates",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "sum(increase(k6_k6_robot_build_id_updates_total{scenario=\"robot\",testid=~\"$testid\",device=~\"$device\"}[$__range]))",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      }
    },
    {
      "type": "timeseries",
      "title": "HTTP RPS by Endpoint",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "sum by (endpoint) (rate(k6_http_reqs_total{app=\"robot\",scenario=\"robot\",testid=~\"$testid\",device=~\"$device\",endpoint=~\"$endpoint\"}[$__rate_interval]))",
          "legendFormat": "{{endpoint}}",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "type": "timeseries",
      "title": "HTTP Latency p95 by Endpoint",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "avg(k6_http_req_duration_seconds_p95{app=\"robot\",scenario=\"robot\",testid=~\"$testid\",device=~\"$device\",endpoint=~\"$endpoint\"}) by (endpoint)",
          "legendFormat": "{{endpoint}}",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "type": "timeseries",
      "title": "Step Latency p95",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "avg(k6_k6_robot_planogram_duration_seconds_p95{scenario=\"robot\",testid=~\"$testid\",device=~\"$device\"})",
          "legendFormat": "planogram",
          "refId": "A"
        },
        {
          "expr": "avg(k6_k6_robot_planogram_list_duration_seconds_p95{scenario=\"robot\",testid=~\"$testid\",device=~\"$device\"})",
          "legendFormat": "planogram_list",
          "refId": "B"
        },
        {
          "expr": "avg(k6_k6_robot_register_duration_seconds_p95{scenario=\"robot\",testid=~\"$testid\",device=~\"$device\"})",
          "legendFormat": "register",
          "refId": "C"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "ms" }, "overrides": [] },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "type": "timeseries",
      "title": "Robot Error Counters",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        { "expr": "sum(increase(k6_k6_robot_business_errors_total{scenario=\"robot\",testid=~\"$testid\",device=~\"$device\"}[$__range]))", "legendFormat": "business_errors", "refId": "A" },
        { "expr": "sum(increase(k6_k6_robot_server_errors_total{scenario=\"robot\",testid=~\"$testid\",device=~\"$device\"}[$__range]))", "legendFormat": "server_errors", "refId": "B" },
        { "expr": "sum(increase(k6_k6_robot_parse_errors_total{scenario=\"robot\",testid=~\"$testid\",device=~\"$device\"}[$__range]))", "legendFormat": "parse_errors", "refId": "C" },
        { "expr": "sum(increase(k6_k6_robot_not_found_errors_total{scenario=\"robot\",testid=~\"$testid\",device=~\"$device\"}[$__range]))", "legendFormat": "not_found_errors", "refId": "D" },
        { "expr": "sum(increase(k6_k6_robot_conflict_errors_total{scenario=\"robot\",testid=~\"$testid\",device=~\"$device\"}[$__range]))", "legendFormat": "conflict_errors", "refId": "E" },
        { "expr": "sum(increase(k6_k6_robot_device_errors_total{scenario=\"robot\",testid=~\"$testid\",device=~\"$device\"}[$__range]))", "legendFormat": "device_errors", "refId": "F" }
      ],
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "type": "table",
      "title": "Device Errors by Machine",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 20 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "format": "table",
          "instant": true,
          "expr": "sum by (device) (increase(k6_k6_robot_device_errors_total{scenario=\"robot\",testid=~\"$testid\",device=~\"$device\"}[$__range]))",
          "refId": "A"
        }
      ],
      "transformations": [
        { "id": "labelsToFields", "options": { "mode": "columns" } }
      ],
      "options": { "showHeader": true, "footer": { "show": false } },
      "fieldConfig": { "defaults": {}, "overrides": [] }
    },
    {
      "type": "timeseries",
      "title": "Build ID Present / Active Cycles",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 20 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "avg(k6_k6_robot_build_id_present{scenario=\"robot\",testid=~\"$testid\",device=~\"$device\"})",
          "legendFormat": "build_id_present",
          "refId": "A"
        },
        {
          "expr": "avg(k6_k6_robot_active_cycles{scenario=\"robot\",testid=~\"$testid\",device=~\"$device\"})",
          "legendFormat": "active_cycles",
          "refId": "B"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "style": "dark",
  "tags": ["", "k6", "victoriametrics", "robot"],
  "templating": {
    "list": [
      {
        "current": { "selected": false, "text": "Prometheus / VictoriaMetrics", "value": "Prometheus" },
        "hide": 0,
        "includeAll": false,
        "label": "Datasource",
        "multi": false,
        "name": "DS_PROMETHEUS",
        "options": [],
        "query": "prometheus",
        "refresh": 1,
        "type": "datasource"
      },
      {
        "current": { "selected": true, "text": ".*", "value": ".*" },
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "definition": "label_values(k6_http_reqs_total, testid)",
        "hide": 0,
        "includeAll": true,
        "label": "testid",
        "multi": false,
        "name": "testid",
        "options": [],
        "query": { "qryType": 1, "query": "label_values(k6_http_reqs_total, testid)", "refId": "TestId" },
        "refresh": 2,
        "sort": 1,
        "type": "query"
      },
      {
        "current": { "selected": true, "text": "All", "value": "$__all" },
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "definition": "label_values(k6_http_reqs_total{app=\"robot\",scenario=\"robot\",testid=~\"$testid\"}, device)",
        "hide": 0,
        "includeAll": true,
        "label": "device",
        "multi": true,
        "name": "device",
        "options": [],
        "query": { "qryType": 1, "query": "label_values(k6_http_reqs_total{app=\"robot\",scenario=\"robot\",testid=~\"$testid\"}, device)", "refId": "Device" },
        "refresh": 2,
        "sort": 1,
        "type": "query"
      },
      {
        "current": { "selected": true, "text": "All", "value": "$__all" },
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "definition": "label_values(k6_http_reqs_total{app=\"robot\",scenario=\"robot\",testid=~\"$testid\"}, endpoint)",
        "hide": 0,
        "includeAll": true,
        "label": "endpoint",
        "multi": true,
        "name": "endpoint",
        "options": [],
        "query": { "qryType": 1, "query": "label_values(k6_http_reqs_total{app=\"robot\",scenario=\"robot\",testid=~\"$testid\"}, endpoint)", "refId": "Endpoint" },
        "refresh": 2,
        "sort": 1,
        "type": "query"
      }
    ]
  },
  "time": { "from": "now-1h", "to": "now" },
  "timezone": "",
  "title": "k6 Robot",
  "uid": "k6-robot",
  "version": 1,
  "weekStart": ""
}
